# База данных
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/autocheckmobile

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# JWT — ЗАМЕНИТЕ на случайную строку (openssl rand -hex 32)
JWT_SECRET=change_me_please

# AI-интеграция (опционально — без ключа graceful degradation)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Приложение
APP_URL=https://your-domain.com
ALLOWED_ORIGINS=["http://localhost:3000","https://your-domain.com"]
DEBUG=false
